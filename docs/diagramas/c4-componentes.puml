@startuml c4-componentes
' Diagrama C4 nivel 3 (componentes) do VAR, versao final.
' As setas resumem os imports reais entre pacotes (tabela completa em docs/arquitetura.md).
!pragma layout smetana
!include <C4/C4_Component>

LAYOUT_TOP_DOWN()

AddElementTag("padrao", $bgColor="#85BBF0", $fontColor="#000000", $borderColor="#0B4884", $borderThickness=3, $legendText="componente com padrão de projeto")
AddElementTag("web", $bgColor="#1F7A4D", $fontColor="#FFFFFF", $borderColor="#0B3D2E", $legendText="adaptador web (Spring)")

title VAR: componentes da aplicação web (nível 3)

Container_Boundary(app, "Aplicação web VAR [Spring Boot 3.5, Java 21]") {
    Component(wcomum, "web.comum", "Spring", "Fundação: segurança, login, layout, repositórios em memória (portas), dados de demonstração, mensagens de erro.", $tags="web")
    Component(worg, "web.organizador", "Spring MVC", "Painel, nova votação, códigos de acesso, gestão ao vivo, abrir/encerrar/apurar, 2º turno.", $tags="web")
    Component(wele, "web.eleitor", "Spring MVC", "Painel do eleitor, voto em 3 telas, comprovante, cédula Top 3, verificação pública.", $tags="web")
    Component(wres, "web.resultado", "Spring MVC", "Resultado, telão, relatório/ata com código de verificação.", $tags="web")
    Component(wpre, "web.premiacao", "Spring MVC", "Configuração da premiação, ranking, pódio e telão.", $tags="web")

    Component(processo, "processo", "Java puro – State", "Agregado Votacao: Rascunho → Aberta → Encerrada → Apurada; auditoria e 2º turno.", $tags="padrao")
    Component(apuracao, "apuracao", "Java puro – Strategy", "RegraApuracao: MaioriaSimples, MaioriaAbsoluta, MaioriaQualificada.", $tags="padrao")
    Component(apur2, "apuracao2turno", "Java puro", "ApuracaoMajoritaria e ResultadoApuracao (sealed).")
    Component(votacao, "votacao + comum", "Java puro", "RegrasVotacao (quórum, fração) e Proporcao.")
    Component(urna, "urna + eleitorado", "Java puro", "Urna (sigilo, um voto por eleitor, comprovante) e Eleitorado (lista de aptos).")
    Component(resultado, "resultado + relatorio", "Java puro", "ResultadoDetalhado e RelatorioApuracao.")
    Component(auditoria, "auditoria", "Java puro", "RegistroAuditoria: só acréscimo, sem conteúdo de votos.")
    Component(top3, "top3", "Java puro", "PremiacaoTop3, CedulaTop3, RankingTop3: pontos por posição × peso do grupo.")
    Component(cadastro, "cadastro", "Java puro", "CadastroCandidatos: opções a partir de candidatos.")
}

Rel_D(worg, wcomum, "usa")
Rel_D(wele, wcomum, "usa")
Rel_D(wres, wcomum, "usa")
Rel_D(wpre, wcomum, "usa")
Rel_R(wpre, wres, "reusa Andamento e exceções de")

Rel_D(wcomum, processo, "guarda Votacao")
Rel_D(worg, processo, "configura e conduz")
Rel_D(wele, processo, "registra votos")
Rel_D(wres, resultado, "mostra")
Rel_D(wpre, top3, "conduz premiação")
Rel_D(wele, top3, "registra cédulas")

Rel_D(processo, apuracao, "delega apuração (Strategy)")
Rel_D(processo, urna, "deposita votos")
Rel_D(processo, auditoria, "registra eventos")
Rel_D(processo, resultado, "monta resultado")
Rel_R(processo, cadastro, "opções do cadastro")
Rel_D(apuracao, apur2, "maioria absoluta / 2º turno")
Rel_D(apuracao, votacao, "quórum e fração")

SHOW_LEGEND()
@enduml
